# AtlasForge Backend Environment Variables (optional)
# Copy to .env and fill in any keys you have. ALL are optional — the system runs
# in deterministic-fallback mode without any keys (honest rule-based extraction).

# Tier 1 — Gemini (Google AI Studio free tier)
# GEMINI_API_KEY=

# Tier 2 — Groq (OpenAI-compatible, generous free tier)
# GROQ_API_KEY=

# Tier 3 — DeepSeek (OpenAI-compatible, free credits)
# DEEPSEEK_API_KEY=

# GitHub enrichment (raises 60req/h -> 5000req/h limit)
# GITHUB_TOKEN=

# Database override (default: SQLite local file)
# ATLAS_DB_URL=sqlite+aiosqlite:///./data/atlas.db

# Backend host/port
# ATLAS_HOST=0.0.0.0
# ATLAS_PORT=8000

# HTTP politeness (seconds between requests to same host)
# ATLAS_RATE_LIMIT=2.0
